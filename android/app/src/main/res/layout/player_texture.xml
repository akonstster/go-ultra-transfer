<?xml version="1.0" encoding="utf-8"?>
<!-- The viewer's player: the picture in a TextureView, which moves and resizes with the layout like any view and keeps
     the last frame — a SurfaceView left a paused picture where it was when the colour panel opened or closed. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />
